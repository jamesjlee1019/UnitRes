# Copy this file to .env and fill in what your team needs:
#     cp .env.example .env
# .env is in .gitignore. Never commit real keys, and don't paste them in the group chat.
# After editing .env, stop the project (Ctrl+C) and run docker compose up again.

# Payments: Stripe test-mode secret key (starts with sk_test_)
# Find it at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Accounts: SendGrid API key, and the sender address you verified in SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=
CALENDLY_URL=https://calendly.com/your-link-here
